{
  "name": "ryuzuya-chats",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/ryuzuya-chats/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build:worker": {
      "executor": "nx:run-commands",
      "options": {
        "command": "webpack-cli build",
        "args": [
          "--config",
          "apps/ryuzuya-chats/webpack.worker.config.js",
          "--node-env=production"
        ]
      },
      "configurations": {
        "development": {
          "args": [
            "--config",
            "apps/ryuzuya-chats/webpack.worker.config.js",
            "--node-env=development"
          ]
        }
      }
    },
    "build:worker:hook": {
      "executor": "nx:run-commands",
      "options": {
        "command": "webpack-cli build",
        "args": [
          "--config",
          "apps/ryuzuya-chats/webpack.worker-hook.config.js",
          "--node-env=production"
        ]
      },
      "configurations": {
        "development": {
          "args": [
            "--config",
            "apps/ryuzuya-chats/webpack.worker.config.js",
            "--node-env=development"
          ]
        }
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "webpack-cli build",
        "args": [
          "--node-env=production"
        ]
      },
      "configurations": {
        "development": {
          "args": [
            "--node-env=development"
          ]
        }
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": [
        "build"
      ],
      "options": {
        "buildTarget": "ryuzuya-chats:build",
        "runBuildTargetDependencies": false
      },
      "configurations": {
        "development": {
          "buildTarget": "ryuzuya-chats:build:development"
        },
        "production": {
          "buildTarget": "ryuzuya-chats:build:production"
        }
      }
    },
    "test": {
      "options": {
        "passWithNoTests": true
      }
    }
  }
}
