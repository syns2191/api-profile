{
  "name": "ryuzuya-chats-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "implicitDependencies": ["ryuzuya-chats"],
  "targets": {
    "e2e": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{e2eProjectRoot}"],
      "options": {
        "jestConfig": "apps/ryuzuya-chats-e2e/jest.config.ts",
        "passWithNoTests": true
      },
      "dependsOn": ["ryuzuya-chats:build", "ryuzuya-chats:serve"]
    }
  }
}
